load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

# gazelle:js_tsconfig_ignore declaration

ts_project(
    name = "tsconfig_ignore_bidirectional",
    srcs = ["main.ts"],
    composite = True,
    tsconfig = ":tsconfig",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
)
